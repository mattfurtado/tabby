{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules", "build", ".plasmo"],
  "include": [".plasmo/index.d.ts", "./**/*.ts", "./**/*.tsx"],
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "types": ["chrome"],
    "paths": { "~*": ["./src/*"] },
    "baseUrl": "."
  }
}
